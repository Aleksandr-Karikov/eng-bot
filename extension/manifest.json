{
  "manifest_version": 3,
  "name": "WordBoss — слова из субтитров",
  "version": "0.2.0",
  "description": "Клик по слову или фразе в субтитрах — и оно в Telegram-боте WordBoss с репликой как контекстом.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://inoriginal.cc/*", "https://*.inoriginal.cc/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "WordBoss: настройки" }
}

# Токен от @BotFather
BOT_TOKEN=
# Путь к файлу SQLite
DB_PATH=data/eng-bot.sqlite
# Модель Claude Code для подсказок (алиас: haiku / sonnet)
ENRICH_MODEL=haiku
ENRICH_TIMEOUT_MS=30000
# Картинки-ассоциации: 1 — включить. Рисует либо внешний API (есть IMAGE_API_KEY), либо локальный FLUX
IMAGES_ENABLED=0
# MFLUX_BIN=tools/imagegen/.venv/bin/mflux-generate
# Рисовалка через API (нужна на Linux: локальный FLUX работает только на Apple Silicon).
# Ключ OpenRouter подойдёт тот же; баланс общий с текстом, поэтому картинки тратят его заметно быстрее.
# IMAGE_API_KEY=
# IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# Стиль картинок (дописывается к сцене). По умолчанию — чернильный комикс с красным акцентом.
# IMAGE_STYLE=watercolor storybook illustration, soft textured paper, gentle colors, no text
# Рисовать картинки заранее, пока очередь пуста и мак на зарядке (0 — только по кнопке)
# IMAGES_BACKGROUND=1
# Модель Claude Code для запоминалок (сильнее основной)
MNEMONIC_MODEL=sonnet
# Модель для проверок: /check, ответы в упражнениях, перевод
CHECK_MODEL=sonnet
# Порт, на котором бот принимает слова из расширения браузера (только localhost); 0 — выключить
# CAPTURE_PORT=8787
# Python с youtube-transcript-api (tools/youtube) и с wordfreq (tools/wordfreq);
# без них не разбираются ссылки на YouTube и не считается частотность слов
# YOUTUBE_PYTHON=tools/youtube/.venv/bin/python
# WORDFREQ_PYTHON=tools/wordfreq/.venv/bin/python
# Озвучка Kokoro (tools/tts) и распознавание речи (tools/stt);
# без них — встроенный голос macOS, а голосовые сообщения не распознаются
# TTS_PYTHON=tools/tts/.venv/bin/python
# STT_PYTHON=tools/stt/.venv/bin/python
# Mini App с карточками: порт (наружу — через ngrok http 8788) и публичный HTTPS-адрес для кнопки «📚 Учить»
# APP_PORT=8788
# APP_URL=https://твой-домен.ngrok-free.app/app/
# Telegram id того, кто чинит бота: ему приходят новые /bug и ему доступна команда /llm
# ADMIN_TELEGRAM_ID=

# --- LLM: чем считать карточки ---
# По умолчанию — локальный Claude Code (ничего настраивать не нужно).
# Второй вариант — OpenRouter: тот же бот, но модель в облаке. Переключение на лету: /llm в боте
# (для админа) или npx tsx scripts/llm.ts openrouter; перезапуск не нужен.
# Имена моделей у OpenRouter свои (anthropic/claude-haiku-5.5, google/gemini-2.5-flash, ...) —
# одну и ту же модель у разных провайдеров зовут по-разному, поэтому алиасы вроде haiku тут не работают.
# Ключ: https://openrouter.ai/keys
# OPEN_ROUTER_API_KEY=
# Модель для всего основного; без неё OpenRouter не включается
# OPENROUTER_MODEL=
# Модели сильнее основной (по умолчанию — основная): запоминалки и проверки
# OPENROUTER_MNEMONIC_MODEL=
# OPENROUTER_CHECK_MODEL=
# С чего начинать после запуска: claude-code (по умолчанию) или openrouter.
# Файл ниже помнит выбор, сделанный из бота, и он важнее этой переменной.
# LLM_PROVIDER=claude-code
# LLM_PROVIDER_FILE=data/llm-provider

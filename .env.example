# Токен от @BotFather
BOT_TOKEN=
# Путь к файлу SQLite
DB_PATH=data/eng-bot.sqlite
# Модель Claude Code для подсказок (алиас: haiku / sonnet)
ENRICH_MODEL=haiku
ENRICH_TIMEOUT_MS=30000
# Картинки-ассоциации локальным FLUX (tools/imagegen/README.md): 1 — включить
IMAGES_ENABLED=0
# MFLUX_BIN=tools/imagegen/.venv/bin/mflux-generate
# Стиль картинок (дописывается к сцене). По умолчанию — чернильный комикс с красным акцентом.
# IMAGE_STYLE=watercolor storybook illustration, soft textured paper, gentle colors, no text
# Рисовать картинки заранее, пока очередь пуста и мак на зарядке (0 — только по кнопке)
# IMAGES_BACKGROUND=1
# Модель Claude Code для запоминалок (сильнее основной)
MNEMONIC_MODEL=sonnet
# Модель для проверок: /check, ответы в упражнениях, перевод
CHECK_MODEL=sonnet
# Порт, на котором бот принимает слова из расширения браузера (только localhost); 0 — выключить
# CAPTURE_PORT=8787
# Python с youtube-transcript-api (tools/youtube) и с wordfreq (tools/wordfreq)
# YOUTUBE_PYTHON=tools/youtube/.venv/bin/python
# WORDFREQ_PYTHON=tools/wordfreq/.venv/bin/python
# Mini App с карточками: порт (наружу — через ngrok http 8788) и публичный HTTPS-адрес для кнопки «📚 Учить»
# APP_PORT=8788
# APP_URL=https://твой-домен.ngrok-free.app/app/

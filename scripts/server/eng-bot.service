[Unit]
Description=Eng Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=engbot
Group=engbot
WorkingDirectory=/opt/eng-bot-git
ExecStart=/usr/local/bin/node --import tsx src/index.ts
Restart=always
RestartSec=5
# Не крутить бесконечный цикл падений навсегда: после 10 перезапусков за 5 минут юнит останавливается.
# Это замена внешнего сторожа: `Restart=always` без ограничения маскировал «бот падает сразу после старта».
StartLimitIntervalSec=300
StartLimitBurst=10
# Остановка должна давать боту время закрыть слушающие серверы и TTS-процесс: shutdown синхронный,
# но long polling в Telegram сам ждёт до 30 с.
TimeoutStopSec=45
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

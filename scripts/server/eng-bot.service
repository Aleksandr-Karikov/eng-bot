[Unit]
Description=Eng Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=engbot
Group=engbot
WorkingDirectory=/opt/eng-bot-git
ExecStart=/usr/local/bin/node --import tsx src/index.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target

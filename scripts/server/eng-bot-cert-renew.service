[Unit]
Description=Renew HTTPS certificate for Eng Bot IP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/certbot-ip/bin/certbot renew --config-dir /etc/letsencrypt-ip --work-dir /var/lib/letsencrypt-ip --logs-dir /var/log/letsencrypt-ip --non-interactive --deploy-hook "/usr/bin/systemctl reload nginx"
